; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Man Versus Machine"
run/main_scene="res://scenes/ui/title_screen.tscn"
config/features=PackedStringArray("4.7")
#Projectdevelopmenttarget:Godot4.7.2.config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

DataRegistry="*res://scripts/autoload/data_registry.gd"
Global="*res://scripts/autoload/global.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[file_customization]

folder_colors={
"res://assets/": "red",
"res://data/": "green",
"res://other_assets/": "orange",
"res://scenes/": "blue",
"res://scripts/": "gray",
"res://shaders/": "purple",
"res://sounds/": "orange"
}

[gui]

theme/custom="res://assets/ui/game_theme.tres"

[layer_names]

2d_physics/layer_1="Map"
2d_physics/layer_2="Player"
2d_physics/layer_3="Bosses"
2d_physics/layer_4="Attacks"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
